# ./configure.sh writes .env for you. To do it by hand: cp .env.example .env and edit.
# .env holds your API key: never commit it.

# ---- Required -----------------------------------------------------------------
STRATA_API_KEY=change-me        # a long random string, e.g. openssl rand -hex 24
VIDEO_GID=44                    # getent group video   (the number)
RENDER_GID=992                  # getent group render  (the number)

# ---- Model --------------------------------------------------------------------
# Starting points by card (only the R9700 row is measured; see README):
#   RX 9060 XT 16 GB / RX 9070 XT 16 GB   CONTEXT=65536
#   RX 7900 XT 20 GB / RX 7900 XTX 24 GB  CONTEXT=131072
#   Radeon AI PRO R9700 32 GB             CONTEXT=262144
# and by RAM: 64 GB -> IQ3_XXS, 32-48 GB -> IQ2_XS.
STRATA_MODEL=IQ3_XXS            # IQ2_XS, IQ3_XXS, IQ3_S, ... (Strata's docs/MODELS.md)
STRATA_CONTEXT=65536            # up to 262144, the model's trained length
STRATA_LOW_RAM=on               # on: experts the card can't hold are read from the pack on disk
                                #     (needed under a memory limit); auto: Strata decides
STRATA_REINSTALL=0              # 1 for ONE start after changing CONTEXT/KV/LOW_RAM of a model
                                #   already set up, then back to 0 (switching MODEL needs no reinstall)
STRATA_KV=                      # empty (int8), q4_0, or k8v4
STRATA_KV_STREAMING=            # empty (auto), on, off

# ---- Cards (only with more than one) -------------------------------------------
STRATA_GPU=                     # e.g. 1: use only that card
STRATA_GPUS=                    # e.g. 0,1 or all: share one model across cards

# ---- Where and how it runs -----------------------------------------------------
STRATA_IMAGE=strata-rocm:local
STRATA_DATA=./strata-data       # models and packs, 70-130 GB per model: put it on an NVMe SSD
STRATA_BIND=127.0.0.1           # 0.0.0.0 to serve the LAN (the API key still applies)
STRATA_PORT=8081
