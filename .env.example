# ./configure.sh writes .env for you. To do it by hand: cp .env.example .env and edit.
# .env holds your API key: never commit it.

# ---- Required -----------------------------------------------------------------
STRATA_API_KEY=change-me        # 16+ characters, e.g. openssl rand -hex 24
VIDEO_GID=44                    # getent group video   (the number)
RENDER_GID=992                  # getent group render  (the number)

# ---- Image ----------------------------------------------------------------------
# Upstream's image, one flavour per card family:
#   rocm-gfx120x   RX 9060 XT, RX 9070 / 9070 XT, Radeon AI PRO R9700 (RDNA 4)
#   rocm-gfx110x   RX 7900 XTX / XT / GRE, RX 7800 XT, RX 7700 XT, RX 7600 XT (RDNA 3)
# latest-<flavour> follows upstream; pin a version (e.g. 0.2.19-rocm-gfx120x) to
# update only when you choose. The ROCm runtime is inside the image.
STRATA_IMAGE=ghcr.io/niko1221/strata:latest-rocm-gfx120x

# ---- Model --------------------------------------------------------------------
# Starting points by card (only the R9700 row is measured; see README):
#   RX 9060 XT 16 GB / RX 9070 XT 16 GB   CONTEXT=64k
#   RX 7900 XT 20 GB / RX 7900 XTX 24 GB  CONTEXT=128k
#   Radeon AI PRO R9700 32 GB             CONTEXT=256k
# and by RAM: 64 GB -> IQ3_XXS or IQ3_S, 32-48 GB -> IQ2_XS.
# Empty MODEL / CONTEXT = Strata chooses for your card and says so in the log.
STRATA_FAMILY=qwen              # qwen = ISTA-DASLab's GSQ-RCO packs; also unsloth, coder, swift, ...
STRATA_MODEL=IQ3_XXS            # IQ2_XS, IQ3_XXS, IQ3_S, Q2_0, ... (Strata's docs/MODELS.md)
STRATA_CONTEXT=64k              # 32k, 64k, 128k, 256k or a number
STRATA_KV=                      # empty (int8), q4_0, k8v4, fp16
STRATA_DRAFTING=                # empty (auto), mtp, dflash2, off
STRATA_PARALLEL=                # requests at once, 1-8; empty = fitted to the card.
                                #   Requests that share the card decode without MTP drafts.
STRATA_VISION=off               # off, on (the model reads pictures; ~0.9 GB more)

# ---- Tuning and engine settings ---------------------------------------------------
STRATA_TUNE=skip                # quick, thorough, skip; done once, kept in /data
STRATA_RETUNE=0                 # 1 for ONE start to tune again (e.g. after an update), then 0
STRATA_SET=                     # engine settings, space separated, e.g. STRATA_SPEC_DEPTH=1
                                #   (Strata's docs/SETTINGS.md)

# ---- Cards (only with more than one) -------------------------------------------
STRATA_GPU=                     # e.g. 1: use only that card
STRATA_GPUS=                    # e.g. 0,1 or all: share one model across cards

# ---- Where and how it runs -----------------------------------------------------
STRATA_DATA=./strata-data       # models and packs, 70-130 GB per model: put it on an NVMe SSD
STRATA_BIND=127.0.0.1           # 0.0.0.0 to serve the LAN (the API key still applies)
STRATA_PORT=8081
